# Copy to .env and change every value before `docker compose up`.
# .env is gitignored.

# --- RustFS (S3) ---
RUSTFS_ACCESS_KEY=changeme-access
RUSTFS_SECRET_KEY=changeme-secret-min-20-chars

# --- PostgreSQL (Nessie version store) ---
POSTGRES_USER=nessie
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=nessie
